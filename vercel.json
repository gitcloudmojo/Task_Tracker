{
    "installCommand":  "npm --prefix server install",
    "buildCommand":  "npm --prefix client install \u0026\u0026 npm --prefix client run build",
    "outputDirectory":  "client/dist",
    "functions":  {
                      "api/**/*.js":  {
                                          "maxDuration":  30
                                      }
                  },
    "rewrites":  [
                     {
                         "destination":  "/api/index.js",
                         "source":  "/api/((?!cron/alerts).*)"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/((?!api/).*)"
                     }
                 ],
    "crons":  [
                  {
                      "path":  "/api/cron/alerts",
                      "schedule":  "0 3 * * *"
                  }
              ]
}
