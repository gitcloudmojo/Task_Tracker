# Copy to server/.env for local development. In production these are set as
# Vercel Environment Variables in the project dashboard instead — this file
# is not deployed.

JWT_SECRET=change-me-before-anything-real
JWT_EXPIRES_IN=12h

# --- database: Turso (libSQL) ------------------------------------------------
# Create a database with the Turso CLI (`turso db create a1k-task-tracker`) or
# at https://turso.tech, then:
#   turso db show a1k-task-tracker --url
#   turso db tokens create a1k-task-tracker
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=

# --- attachments: Vercel Blob -------------------------------------------------
# Created automatically as BLOB_READ_WRITE_TOKEN when you add a Blob store to
# the Vercel project (Storage tab) and link it — copy it here for local dev.
BLOB_READ_WRITE_TOKEN=
BLOB_PREFIX=a1k-attachments

# CORS origin for local dev only (client and server run on separate ports).
# Not used in production — client and API are served from the same domain.
CLIENT_ORIGIN=http://localhost:5174

# Sweep for overdue work and stalled approvals. Only read by `npm run dev`'s
# local process and by api/cron/alerts.js's own logic, not by anything that
# schedules it — see vercel.json for the actual cadence Vercel Cron runs on.
ALERT_CRON=*/15 * * * *
REVIEW_SLA_DAYS=2

# Set automatically by Vercel for its own Cron requests; only needed here if
# you are pinging /api/cron/alerts yourself from an external scheduler.
CRON_SECRET=

# See config.js — kept low to stay under a Vercel serverless function's own
# 4.5 MB request body ceiling.
MAX_UPLOAD_BYTES=4194304

# Standard/SQLite-compatible edition only — this deployment target does not
# support STORE=workbook (Excel Edition). Leave as sqlite.
STORE=sqlite
